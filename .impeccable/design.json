  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one blue action per view (Add evidence, Accept, Extract cards).",
      "html": "<button class=\"ds-btn-primary\"><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M8 3.5v9M3.5 8h9\"/></svg>Add evidence</button>",
      "css": ".ds-icon{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none} .ds-btn-primary{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--accent-strong);border-radius:var(--radius-sm);background:var(--accent-strong);color:var(--on-accent);padding:8px 14px;font:600 var(--fs-small)/1.2 var(--font-ui);cursor:pointer;transition:background .12s ease,border-color .12s ease} .ds-btn-primary:hover{background:var(--accent-rust);border-color:var(--accent-rust)} .ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions: white field, hairline outline, ink label.",
      "html": "<button class=\"ds-btn-ghost\"><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10\"/></svg>Export Markdown</button>",
      "css": ".ds-icon{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none} .ds-btn-ghost{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line-strong);border-radius:var(--radius-sm);background:var(--field);color:var(--ink-soft);padding:7px 12px;font:500 var(--fs-small)/1.2 var(--font-ui);cursor:pointer;transition:background .12s ease,border-color .12s ease} .ds-btn-ghost:hover{border-color:var(--line-bold);background:var(--raised);color:var(--ink)} .ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Hairline field; focus turns the border blue with a 1px ring.",
      "html": "<label class=\"ds-field\"><span>Research question</span><input placeholder=\"Why does bottled juice lose vitamin C?\"></label>",
      "css": ".ds-field{display:grid;gap:6px;width:320px;font-family:var(--font-ui)} .ds-field span{color:var(--ink-soft);font:600 var(--fs-small) var(--font-ui)} .ds-field input{border:1px solid var(--line-strong);border-radius:var(--radius-sm);background:var(--field);color:var(--ink);padding:8px 10px;font:400 var(--fs-body) var(--font-ui);transition:border-color .12s ease,box-shadow .12s ease} .ds-field input::placeholder{color:var(--muted)} .ds-field input:hover{border-color:var(--line-bold)} .ds-field input:focus{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent);outline:0}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "tabs-segmented",
      "description": "Project tabs as a segmented control in the 48px top bar.",
      "html": "<nav class=\"ds-tabs\"><button class=\"on\">Web</button><button>Cards</button><button>Sources</button><button>Question &amp; history</button><button>Insights</button></nav>",
      "css": ".ds-tabs{display:inline-flex;gap:2px;padding:3px;border-radius:var(--radius-md);background:var(--sunken)} .ds-tabs button{border:0;border-radius:var(--radius-sm);background:transparent;color:var(--muted-strong);padding:6px 12px;font:600 var(--fs-small) var(--font-ui);cursor:pointer} .ds-tabs button:hover:not(.on){background:rgba(255,255,255,.6);color:var(--ink)} .ds-tabs button.on{background:var(--card);color:var(--ink);box-shadow:var(--shadow-control)} .ds-tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Legend Panel",
      "kind": "custom",
      "refersTo": "floating-panel",
      "description": "Floating layer-list legend: colour in dots and line samples, words in ink, counts in mono.",
      "html": "<div class=\"ds-legend\"><button style=\"--c:var(--origin-external)\"><i></i>External source<small>4</small></button><button style=\"--c:var(--origin-experiment)\"><i></i>My experiment<small>2</small></button><button style=\"--c:var(--origin-hypothesis)\"><i></i>My hypothesis<small>3</small></button><hr><button style=\"--c:var(--relation-supports)\"><b></b>Supports<small>3</small></button><button class=\"dash\" style=\"--c:var(--relation-contradicts)\"><b></b>Contradicts<small>3</small></button></div>",
      "css": ".ds-legend{width:248px;padding:10px;border-radius:var(--radius-lg);background:var(--card);box-shadow:var(--shadow-float);font-family:var(--font-ui)} .ds-legend hr{border:0;border-top:1px solid var(--line-soft);margin:8px 0} .ds-legend button{display:flex;align-items:center;gap:10px;width:100%;border:0;border-radius:var(--radius-sm);background:transparent;padding:6px 8px;color:var(--ink-soft);font:500 var(--fs-small) var(--font-ui);cursor:pointer} .ds-legend button:hover{background:var(--sunken)} .ds-legend button:focus-visible{outline:2px solid var(--accent);outline-offset:0} .ds-legend i{width:10px;height:10px;border-radius:50%;background:var(--c)} .ds-legend b{width:14px;border-top:2px solid var(--c)} .ds-legend .dash b{border-top-style:dashed} .ds-legend small{margin-left:auto;color:var(--muted);font:500 var(--fs-label) var(--font-mono)}"
    },
    {
      "name": "Canvas Toolbar and Zoom",
      "kind": "custom",
      "refersTo": "zoom-button",
      "description": "Floating bottom chrome: drawn icons, transparent buttons, mono zoom level.",
      "html": "<div class=\"ds-hud\"><button><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 2.5h10v8l-3 3H3ZM10 13.5v-3h3\"/></svg>Sticky note</button><button><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10\"/></svg>Fit to view</button><span class=\"sep\"></span><button class=\"sq\" aria-label=\"Zoom out\"><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8h9\"/></svg></button><output>86%</output><button class=\"sq\" aria-label=\"Zoom in\"><svg class=\"ds-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M8 3.5v9M3.5 8h9\"/></svg></button></div>",
      "css": ".ds-icon{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none} .ds-hud{display:inline-flex;align-items:center;gap:4px;padding:6px;border-radius:var(--radius-lg);background:var(--card);box-shadow:var(--shadow-float)} .ds-hud button{display:inline-flex;align-items:center;gap:6px;height:32px;border:0;border-radius:var(--radius-sm);background:transparent;padding:0 10px;color:var(--ink-soft);font:500 var(--fs-small) var(--font-ui);cursor:pointer} .ds-hud button.sq{width:32px;padding:0;justify-content:center} .ds-hud button:hover{background:var(--sunken)} .ds-hud button:focus-visible{outline:2px solid var(--accent);outline-offset:0} .ds-hud .sep{width:1px;height:20px;background:var(--line);margin:0 4px} .ds-hud output{min-width:48px;text-align:center;color:var(--ink-soft);font:500 var(--fs-small) var(--font-mono)}"
    },
    {
      "name": "Evidence Card",
      "kind": "card",
      "refersTo": "web-card",
      "description": "Canvas card: origin dot and citation over the claim; blue outline when selected.",
      "html": "<article class=\"ds-wc\" tabindex=\"0\"><p><i></i>Source · Haddad 2021</p><h4>Open containers lose far more than sealed ones</h4></article>",
      "css": ".ds-wc{width:210px;padding:9px 11px 10px;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--card);box-shadow:var(--shadow-card);transition:box-shadow .15s ease;cursor:pointer} .ds-wc:hover{box-shadow:var(--shadow-lift)} .ds-wc:focus-visible{outline:2px solid var(--accent);outline-offset:2px} .ds-wc p{display:flex;align-items:center;gap:6px;margin:0 0 4px;color:var(--ink-soft);font:500 var(--fs-label) var(--font-ui)} .ds-wc i{width:7px;height:7px;border-radius:50%;background:var(--origin-external)} .ds-wc h4{margin:0;color:var(--ink);font:500 var(--fs-body)/1.38 var(--font-ui)}"
    },
    {
      "name": "Hypothesis Hub Card",
      "kind": "card",
      "refersTo": "web-card-hub",
      "description": "The one dark object on the canvas: charcoal, magenta outline, white guess.",
      "html": "<article class=\"ds-hub\" tabindex=\"0\"><p>My hypothesis</p><h4>Oxygen exposure is the main driver of vitamin C loss.</h4><footer><span class=\"f\">2 for</span><span class=\"a\">1 against</span></footer></article>",
